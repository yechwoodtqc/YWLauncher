<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#142333</item>
        <item name="android:navigationBarColor">#142333</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorButtonNormal">#EDF3F9</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:navigationBarColor">#101820</item>
        <item name="android:windowBackground">#101820</item>
        <item name="android:colorButtonNormal">#263746</item>
        <item name="android:alertDialogTheme">@style/AppDialogDarkTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="AppDialogDarkTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#48A7FF</item>
        <item name="android:windowBackground">#18232F</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="FullScreenDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
    <style name="FullScreenDialogDarkTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">#101820</item>
    </style>
</resources>
