        <receiver android:name=".DateWidgetProvider" android:label="English and Hebrew Date" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/date_widget_info"/></receiver>
    </application>
</manifest>
